[Unit]
Description=Capital Ledger mobile web app
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/stockbot/dashboard
Environment=DASH_STATE_DIR=/home/ubuntu/.local/state/capital-ledger
ExecStart=/home/ubuntu/.venvs/capital-ledger/bin/uvicorn mobile_app:app --host 127.0.0.1 --port 8502 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
